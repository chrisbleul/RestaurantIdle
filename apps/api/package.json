{
  "name": "@restaurant-idle/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify-Backend fuer Restaurant Idle Game -- Saves und serverautoritativer Offline-Progress.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cgo/platform-auth": "github:chrisbleul/platform-auth#v1.0.0",
    "fastify": "^5.11.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
