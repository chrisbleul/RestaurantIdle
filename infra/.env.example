# Vorlage. Kopieren nach infra/.env, echte Werte eintragen, chmod 600.
# infra/.env gehoert NICHT ins Repo -- .gitignore verhindert das.

# Datenbank: gemeinsamer platform-db-Stack (cgo-platform-Repo,
# apps/platform-db). Muss mit dem Wert dort (Rolle "restaurant_idle")
# uebereinstimmen. Erzeugen mit: openssl rand -hex 24 (kein base64 --
# Sonderzeichen brechen postgres://-URLs)
RESTAURANT_IDLE_DB_PASSWORD=

# Wird vom Deploy gesetzt, damit /api/health sagt, welcher Stand laeuft.
GIT_REVISION=dev

# GitHub-Org/-User, unter der das Image in GHCR liegt (ghcr.io/<owner>/restaurant-idle-api).
GHCR_OWNER=chrisbleul
