<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Vendor/BreakInfinity/BigDouble.cs ist unveraendertes Drittanbieter-Upstream
         (Razenpok/BreakInfinity.cs) von vor nullable reference types, Warnungen
         dort unterdruecken statt den Vendor-Code zu veraendern. -->
    <NoWarn>CS8765;CS8767;CS8625</NoWarn>
  </PropertyGroup>

</Project>
